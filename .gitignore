# Source photography and captures: hundreds of megabytes, and the build only needs the
# derived crops, which are cheap to regenerate with people/make_faces.py + make_collage.py.
photos.zip
*.heic
build/people/src/
build/people/faces/
build/people/tiles/
build/people/strips/
reference/legacy-site/assets/

# Loose photographs dropped in the project root on their way into people/src/better
/*.jpg
/*.jpeg
/*.png

# Build output. index.html is the deployable artefact and is regenerated by build_site.py;
# tracking a 7 MB file that changes on every run would make the history unusable.
build/poopomics-v1.html
build/poopomics-v1-artifact.html
deploy/index.html

# Local
.DS_Store
__pycache__/
.venv-faces/
